<?xml version="1.0" encoding="UTF-8"?>
<!--
  Concat's Windows Installer package, the .msi beside the Inno Setup .exe.

  Built by build-app.yml with WiX from the staged folder the .exe is made
  of, so the two installers ship the same files. The .exe is the
  one a person double-clicks; this is the one an administrator deploys -
  Group Policy, Intune, winget - and it installs for the machine, into
  Program Files, with a Start menu entry and a clean uninstall. Handed in:

    wix build -arch x64 -d Version=0.2.12 -d Root=C:\...\Concat
              -d Stage=C:\...\stage\Concat-0.2.12-windows-x86_64
              -o stage\Concat-0.2.12-windows-x86_64.msi assets\windows\concat.wxs

  Root is the repository: WiX resolves a source path against where it is
  run from, not against this file.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Unique upgrade code for CanCup so it installs standalone and replaces older CanCup builds. -->
  <Package Name="CanCup"
           Manufacturer="CanCup contributors"
           Version="$(var.Version)"
           UpgradeCode="7D5E6E9F-0C3B-4E2C-9F2D-6B8E3C0A1D22"
           Scope="perMachine"
           Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer version of CanCup is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="concup.ico" SourceFile="$(var.Root)\assets\icons\concup.ico" />
    <Property Id="ARPPRODUCTICON" Value="concup.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/HDilann/CanCup" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="CanCup" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="CanCup" />
    </StandardDirectory>

    <Feature Id="Main" Title="CanCup" Level="1">
      <ComponentGroupRef Id="Program" />
      <ComponentRef Id="StartMenu" />
    </Feature>

    <!-- Every file in the staged folder, as it is there. -->
    <ComponentGroup Id="Program" Directory="INSTALLFOLDER">
      <Files Include="$(var.Stage)\**" />
    </ComponentGroup>

    <Component Id="StartMenu" Directory="ShortcutFolder" Guid="3A1C8D62-7F5E-4B2C-0D4F-9E6A2B3C4D55">
      <Shortcut Id="StartMenuShortcut"
                Name="CanCup"
                Description="Video editor"
                Target="[INSTALLFOLDER]concup.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="concup.ico" />
      <!-- The way in when a graphics driver draws the window as coloured
           squares: it turns off Settings > General > Draw on the GPU,
           which that window hides. -->
      <Shortcut Id="SafeGraphicsShortcut"
                Name="CanCup (safe graphics)"
                Description="CanCup, drawn in software"
                Target="[INSTALLFOLDER]concup.exe"
                Arguments="--software"
                WorkingDirectory="INSTALLFOLDER"
                Icon="concup.ico" />
      <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\CanCup" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>

